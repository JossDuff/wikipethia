# The public edge: TLS (automatic Let's Encrypt) + rate limiting in front of
# the loopback-bound MCP server. Replace mcp.example.org with your domain —
# it must match --allow-host in wikipethia-mcp.service.
#
# The rate_limit directive is NOT in stock Caddy: download a build that
# includes github.com/mholt/caddy-ratelimit from caddyserver.com/download
# (or build with xcaddy). If you run stock Caddy, delete the rate_limit
# block — you lose abuse protection, not correctness.

{
	# rate_limit is a non-standard directive; without an order it can't be
	# used in a site block.
	order rate_limit before reverse_proxy
}

mcp.example.org {
	# Generous for a real agent session (tools are sub-second reads),
	# tight enough to bound a scraper: 30 requests/min per client IP.
	rate_limit {
		zone per_ip {
			key {remote_host}
			events 30
			window 1m
		}
	}

	reverse_proxy 127.0.0.1:8642
}
